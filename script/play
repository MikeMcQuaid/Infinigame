#!/bin/bash
# script/play: play the game as a standalone app, outside the editor. Builds it first if the
# project has changed since the last build, or if the last build was made where Burst cannot run
# (script/unity says where) and so is slow. It starts full screen; Option-Return switches to a window.
#
# The game's own log goes to Logs/Player.log and a record of its frame rate to Logs/frames.log,
# both inside the project where whoever is tuning it can read them.
set -euo pipefail
cd "$(dirname "$0")/.."

source script/lib/burst
app=Build/Infinigame.app
stamp=Build/.macos-build-complete
if [ ! -d $app ] || [ ! -f "$stamp" ] || [ -n "$(find Assets Packages ProjectSettings ThirdParty/Festival script/build script/lib/build-target script/lib/burst script/build-speech STORY.md MISSIONS.md FACTIONS.md COLONIES.md -newer "$stamp" -print -quit)" ] ||
  { burst_required && [ -z "$(burst_library StandaloneOSX || true)" ]; }; then
  script/build
fi
mkdir -p Logs
open $app --args -logFile "$PWD/Logs/Player.log" -frameLog "$PWD/Logs/frames.log"
