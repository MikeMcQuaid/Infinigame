#!/bin/bash
# Export, compile and link an iPhone/iPad app; reuse the owner's local signing team.
set -euo pipefail
cd "$(dirname "$0")/.."
build_unsigned=false
if [ "${1:-}" = --unsigned ]; then
  build_unsigned=true
elif [ -n "${1:-}" ]; then
  echo 'Usage: script/build-ios [--unsigned]' >&2
  exit 1
fi
if [ -z "${INFINIGAME_APPLE_TEAM:-}" ] && [ -f Build/iOS/Unity-iPhone.xcodeproj/project.pbxproj ]; then
  INFINIGAME_APPLE_TEAM=$(sed -n 's/.*DEVELOPMENT_TEAM = "\{0,1\}\([A-Z0-9]*\)"\{0,1\};/\1/p' Build/iOS/Unity-iPhone.xcodeproj/project.pbxproj | head -1)
  export INFINIGAME_APPLE_TEAM
fi
script/lib/build-target iOS Infinigame.Editor.Platforms.IOS Logs/build-ios.log
script/lib/build-ios-xcode "$@"
