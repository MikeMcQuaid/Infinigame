#!/bin/bash
# script/build: build the macOS app to Build/Infinigame.app. Unity's own account of it goes to
# Logs/build.log; progress and installation instructions are printed here.
# Needs a Unity licence (script/setup) and the project closed in the editor.
set -euo pipefail
cd "$(dirname "$0")/.."

# macOS defaults can leave the generated plist writable only by the previous builder.
plist=Build/Infinigame.app/Contents/Info.plist
if [ -f "$plist" ] && [ ! -w "$plist" ]; then rm -f "$plist"; fi

script/lib/build-target StandaloneOSX Infinigame.Editor.EditorTools.BuildMac Logs/build.log
touch Build/.macos-build-complete
echo "==> Built $PWD/Build/Infinigame.app"
echo "Run ./script/play for gameplay with performance logs, or open Build/Infinigame.app in Finder."
