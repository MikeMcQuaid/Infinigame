#!/bin/bash
# A desktop Windows build without automatic XR, playable through Proton.
set -euo pipefail
cd "$(dirname "$0")/.."
script/lib/build-target Win64 Infinigame.Editor.Platforms.SteamDeck Logs/build-steam-deck.log
mkdir -p Build/Packages/SteamDeck
rm -rf Build/Packages/SteamDeck/Infinigame
/usr/bin/ditto Build/SteamDeck Build/Packages/SteamDeck/Infinigame
cp Assets/Infinigame/Icon.png Build/Packages/SteamDeck/Infinigame/Infinigame.png
/usr/bin/ditto -c -k --keepParent Build/Packages/SteamDeck/Infinigame Build/Infinigame-SteamDeck.zip
echo "Built: $PWD/Build/Infinigame-SteamDeck.zip"
echo "On Deck: Power > Switch to Desktop. Copy and extract this zip into Documents."
echo "Steam > Games > Add a Non-Steam Game > Browse: choose Infinigame/Infinigame.exe."
echo "Properties > Compatibility > Force a compatibility tool: choose Proton Experimental. Return to Gaming Mode and launch."
echo "Use the Gamepad with Mouse Trackpad Steam Input layout. A confirms, RT fires, Y changes weapon, X interacts and View toggles the map. Touch and keyboard also work. Set Steam Properties > General > Game Resolution to Native."
