#!/bin/bash
# Package existing build output. The same archives are used locally, in CI and in releases.
set -euo pipefail
cd "$(dirname "$0")/.."
platform=${1:?Usage: script/package macOS|Windows|SteamDeck|iOS}
case "$platform" in
  macOS|Windows|SteamDeck|iOS) ;;
  *) echo "Unknown platform: $platform" >&2; exit 1 ;;
esac
package="Build/Packages/$platform/Infinigame"
rm -rf "$package"
mkdir -p "$package"
case "$platform" in
  macOS)
    /usr/bin/ditto "${2:-Build/Infinigame.app}" "$package/Infinigame.app"
    if [[ -n "${2:-}" ]]; then
      # Direct downloads run outside the Mac App Store. Sign only the copy.
      rm -f "$package/Infinigame.app/Contents/embedded.provisionprofile"
      codesign --force --deep --sign - "$package/Infinigame.app"
      codesign --verify --deep --strict "$package/Infinigame.app"
    fi
    ;;
  Windows|SteamDeck)
    cp -R "Build/$platform/." "$package/"
    cp Assets/Infinigame/Icon.png "$package/Infinigame.png"
    ;;
  iOS)
    /usr/bin/ditto Build/iOS "$package/iOS"
    /usr/bin/ditto Build/iOSDerived/Build/Products/Release-iphoneos/Infinigame.app "$package/Infinigame.app"
    ;;
esac
cat > "$package/INSTALL.md" <<EOF
# Infinigame: $platform

Extract the entire Infinigame folder before running the game. Keep its files together. Close an older running copy before replacing it; save slots live outside this folder.

EOF
case "$platform" in
  macOS) cat >> "$package/INSTALL.md" <<'EOF'
Open Infinigame.app. This build is ad-hoc signed rather than Developer ID notarised. If macOS blocks this downloaded copy, allow it through System Settings > Privacy & Security > Open Anyway after checking its source.
EOF
    ;;
  Windows) cat >> "$package/INSTALL.md" <<'EOF'
Run Infinigame.exe. For VR, install SteamVR, choose it as the OpenXR runtime in SteamVR Settings > OpenXR, connect your headset and launch the game.
EOF
    ;;
  SteamDeck) cat >> "$package/INSTALL.md" <<'EOF'
In Desktop Mode, use Steam > Games > Add a Non-Steam Game > Browse and select Infinigame.exe. In its Properties > Compatibility, force Proton Experimental. Set General > Game Resolution to Native, then return to Gaming Mode. Use the Gamepad with Mouse Trackpad Steam Input layout. A confirms, RT fires, Y changes weapon, X interacts and View toggles the map. Touch also works. Infinigame.png is included for the Steam shortcut icon.
EOF
    ;;
  iOS) cat >> "$package/INSTALL.md" <<'EOF'
On a Mac with Xcode, open iOS/Unity-iPhone.xcodeproj. Connect and trust your iPhone/iPad, enable Developer Mode on the device and select it in Xcode. Choose the Unity-iPhone target, your signing Team and Automatically manage signing, then Product > Run. The included Infinigame.app is an unsigned compile check and cannot be installed directly. For TestFlight, use the signed release distributed through Apple's TestFlight app.
EOF
    ;;
esac
cat >> "$package/INSTALL.md" <<'EOF'

[Controls, voice options and detailed platform instructions](https://github.com/MikeMcQuaid/Infinigame/blob/main/PLATFORMS.md)
EOF
archive="$PWD/Build/Infinigame-$platform.zip"
rm -f "$archive"
if [[ "$(uname -s)" == Darwin ]]; then
  /usr/bin/ditto -c -k --keepParent "$package" "$archive"
else
  (cd "Build/Packages/$platform" && zip -qr "$archive" Infinigame)
fi
echo "Packaged: $archive"
