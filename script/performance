#!/usr/bin/env python3
"""Summarise the latest real player session, excluding menus and loading screens."""
import argparse
import csv
from pathlib import Path
from statistics import median

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('log', nargs='?', default='Logs/frames.log')
args = parser.parse_args()
sessions = []
header = None
for line in Path(args.log).read_text().splitlines():
    if line.startswith('# ') and ' Unity ' in line:
        sessions.append({'title': line[2:], 'rows': [], 'info': []})
        header = None
    elif not sessions:
        continue
    elif line.startswith('# '):
        sessions[-1]['info'].append(line[2:])
    elif line.startswith('time\t'):
        header = line.split('\t')
    elif header:
        values = next(csv.reader([line], delimiter='\t'))
        if len(values) == len(header):
            sessions[-1]['rows'].append(dict(zip(header, values)))
players = [session for session in sessions if 'player' in session['title'] and session['rows']]
if not players:
    raise SystemExit('No real player session found. Play with script/play first.')
session = players[-1]
print(session['title'])
print('\n'.join(session['info']))
rows = [row for row in session['rows'] if row['doing'] in ('foot', 'flying', 'autopilot', 'landed')]
print('Medians across logged sample windows. Each p95 comes from its own window.')
print('Activity      Samples     FPS    p95 ms   Worst ms   Work ms    GPU ms')
for activity in ('foot', 'flying', 'autopilot', 'landed'):
    subset = [row for row in rows if row['doing'] == activity]
    if not subset:
        continue
    def mid(key):
        return median(float(row.get(key, 0)) for row in subset)
    worst = max(float(row['worst_ms']) for row in subset)
    print(f'{activity:12} {len(subset):7d} {mid("fps"):7.1f} {mid("p95_ms"):9.1f} {worst:10.1f} {mid("work_ms"):9.1f} {mid("gpu_ms"):9.1f}')
print('\nLargest active stalls:')
for row in sorted(rows, key=lambda row: float(row['worst_ms']), reverse=True)[:8]:
    print(f'{row["time"]}s: {row["worst_ms"]} ms, {row["doing"]}, {row["where"]}, {row["pixels"]}, {row["detail"]}, {row["foes"]} foes')
