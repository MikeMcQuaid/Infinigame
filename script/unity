#!/bin/bash
# script/unity: run the Unity editor this project is pinned to, against this project.
# Arguments are passed straight to Unity. `script/unity --path` only prints the editor's path.
set -euo pipefail
cd "$(dirname "$0")/.."

version=$(awk '/^m_EditorVersion:/ { print $2 }' ProjectSettings/ProjectVersion.txt)
unity=${UNITY:-/Applications/Unity/Hub/Editor/$version/Unity.app/Contents/MacOS/Unity}
if [ ! -x "$unity" ]; then
  echo "Unity $version was not found at $unity. Run script/bootstrap." >&2
  exit 1
fi
if [ "${1:-}" = --path ]; then
  echo "$unity"
  exit
fi

# A licence is tied to one user and to a network hardware address that changes now and then.
# Unity Hub refreshes it for whoever is signed in there. A user activated by script/setup has
# only the Unity CLI to do that, so check before every launch.
# Exit status 4 means no licence. Anything else, such as a CLI that will not run, is left for
# Unity itself to report.
export UNITY_NO_BANNER=1
if command -v unity &>/dev/null; then
  unity license status &>/dev/null || status=$?
  if [ "${status:-0}" = 4 ]; then
    unity license activate --personal --accept-eula >/dev/null || {
      echo "$(id -un) has no Unity licence. Run script/setup." >&2
      exit 1
    }
  fi
fi
# Burst decides it is on a Mac by looking for /Volumes, which some sandboxes hide. It then fails
# to load, so run without it there: jobs still work, only slower.
source script/lib/burst
burst_required || set -- -burst-disable-compilation "$@"
exec "$unity" -projectPath "$PWD" "$@"
