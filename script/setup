#!/bin/bash
# script/setup: get a fresh clone ready to work on: a Unity licence for this user, and a sign-in
# to Claude or ChatGPT for the game's scanner and hermit.
#
# Unity licences belong to one operating-system user. Signing in to Unity Hub licenses your own
# account. Any other account that runs Unity from the command line (script/build,
# script/test --unity), such as a sandbox user, needs its own activation, which this does with
# the Unity CLI. Its sign-in happens in a browser, so two-factor accounts work, and the browser
# can belong to a different user from the one running this script.
set -euo pipefail
cd "$(dirname "$0")/.."

script/bootstrap
export UNITY_NO_BANNER=1

# Optional text replies use the player's own Claude Code or Codex sign-in, or an API key.
# The game has authored guidance and observed scanner facts when neither is available.
voices=""
if [ -n "${ANTHROPIC_API_KEY:-}" ] || claude auth status 2>/dev/null | grep -q '"loggedIn": *true'; then voices="Claude"; fi
if [ -n "${OPENAI_API_KEY:-}" ] || codex login status &>/dev/null; then voices="${voices:+$voices and }ChatGPT"; fi
if [ -n "$voices" ]; then
  echo "==> $(id -un) can reach $voices for the scanner and the hermit"
elif [ -t 0 ] && command -v claude &>/dev/null; then
  echo "==> Signing $(id -un) in to Claude for the scanner and the hermit: approve in the browser"
  claude auth login || echo "==> Not signed in. The game plays without it; sign in or give a key under Settings on its menu."
else
  echo "==> For the scanner and the hermit to speak, sign in or give a key under Settings on the game's menu"
fi
if unity license status &>/dev/null; then
  echo "==> $(id -un) has a Unity licence"
  exit
fi

echo "==> $(id -un) has no Unity licence"
if [ ! -t 0 ]; then
  echo "Run script/setup in a terminal as $(id -un) to activate one."
  exit 1
fi
# Prints a sign-in URL: open it in any browser where you can sign in to your Unity account.
unity auth status &>/dev/null || unity auth login
echo "==> Activating Unity Personal, which accepts its licence terms for $(id -un)"
unity license activate --personal --accept-eula
unity license status
