#!/bin/bash
# Check release gating and signing cleanup without contacting Apple.
set -euo pipefail
cd "$(dirname "$0")/.."
ruby -ryaml <<'WORKFLOW'
workflow = YAML.safe_load(File.read('.github/workflows/release.yml'), aliases: true)
events = workflow['on'] || workflow.fetch(true)
abort 'Use the same platform jobs for PRs, main pushes and manual checks' unless
  events.dig('pull_request', 'branches') == ['main'] && events.dig('push', 'branches') == ['main'] &&
  events.key?('workflow_dispatch')
abort 'CI must not run on a schedule' if events.key?('schedule')
jobs = workflow.fetch('jobs')
mac = jobs.fetch('apple')
abort 'Share one Xcode 27 runner between macOS and iOS' unless mac['runs-on'] == 'xcode-27' && !mac.key?('strategy')
%w[windows apple].each do |id|
  platform = jobs.fetch(id)
  abort "#{id} must run independently and skip fork PRs" unless !platform.key?('needs') &&
    platform.fetch('if') == "github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository"
end
abort 'Only a push to main may publish builds' unless workflow.dig('env', 'PUBLISH') ==
  "${{ github.event_name == 'push' && github.ref == 'refs/heads/main' }}"
steps = mac.fetch('steps')
abort 'Prepare the shared Unity editor only once' unless steps.count { |s| s['uses'] == './.github/actions/prepare-unity' } == 1
by_id = steps.select { |s| s['id'] }.to_h { |s| [s['id'], s] }
targets = %w[mac ios]
targets.each do |target|
  plan, compile, verify, upload = %w[plan compile verify upload].map { |phase| by_id.fetch("#{phase}-#{target}") }
  abort 'Use the platform build identity and the same signing credentials throughout' unless
    plan['uses'] == './.github/actions/plan-testflight' && compile['uses'] == './.github/actions/compile-unity' &&
    verify['run'] == 'script/testflight --verify' && upload['run'] == 'script/testflight --upload-archive' &&
    verify['env'] == upload['env'] && verify.dig('env', 'TESTFLIGHT_PLATFORM') == plan.dig('env', 'TESTFLIGHT_PLATFORM') &&
    upload.fetch('if').include?("env.PUBLISH == 'true'") && upload.fetch('if').include?("steps.verify-#{target}.outcome == 'success'") &&
    upload.fetch('if').include?("steps.groups.outcome == 'success'")
end
ids = steps.map { |s| s['id'] }
abort 'Finish both platform checks and the Mac download before uploading' unless
  ids.index('verify-ios') < ids.index('upload-mac') && ids.index('verify-mac') < ids.index('upload-ios') &&
  ids.index('package') < ids.index('upload-mac')
abort 'Keep a downloadable Mac build when Apple validation fails' unless by_id.fetch('package').fetch('if').include?('!cancelled()') &&
  steps.any? { |s| s.dig('with', 'name') == 'Infinigame-macOS' && s.fetch('if').include?("steps.package.outcome == 'success'") }
windows = jobs.dig('windows', 'steps').select { |s| s['uses'].to_s.start_with?('actions/upload-artifact@') }
abort 'Only publish merged Windows builds' unless windows.map { |s| s.dig('with', 'name') }.sort == %w[Infinigame-Windows] &&
  windows.all? { |s| s['if'] == "env.PUBLISH == 'true'" }
dist = jobs.fetch('distribute')
abort 'Only hand recovered builds to distribution after checking the tester groups' unless
  targets.all? { |target| mac.fetch('outputs').fetch("#{target}-number").include?("steps.groups.outcome == 'success'") }
abort 'Distribute uploaded builds on Linux on main pushes' unless dist['runs-on'] == 'ubuntu-24.04' &&
  dist['needs'] == 'apple' && dist['if'].include?("github.event_name == 'push'") &&
  dist.fetch('steps').select { |step| step.key?('run') }.map { |step| step['run'] } == ['ruby .github/testflight.rb public'] * 2
puts 'TestFlight workflow checks passed'
WORKFLOW
mkdir -p tmp
scratch="$(mktemp -d "$PWD/tmp/test-testflight.XXXXXX")"
trap 'rm -rf "$scratch"' EXIT
mkdir -p "$scratch/bin" "$scratch/script" "$scratch/.github" "$scratch/Build/iOS/Unity-iPhone.xcodeproj"
cp script/testflight "$scratch/script/testflight"
cp .github/testflight.rb "$scratch/.github/"
cp TESTFLIGHT.md "$scratch/TESTFLIGHT.md"
touch "$scratch/Build/iOS/Unity-iPhone.xcodeproj/project.pbxproj"
plutil -create xml1 "$scratch/Build/iOS/Info.plist"
/usr/libexec/PlistBuddy -c 'Add :CFBundleVersion string 1.1' -c 'Add :CFBundleShortVersionString string 0.1.0' "$scratch/Build/iOS/Info.plist"
(
  cp script/build-number "$scratch/script/"
  cd "$scratch"
  unset GITHUB_REF
  git init -q -b main
  git config user.name Tester
  git config user.email tester@example.com
  git config commit.gpgsign false
  git commit -q --allow-empty -m First
  git commit -q --allow-empty -m Second
  script/build-number Build/iOS/Info.plist
  [ "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleVersion' Build/iOS/Info.plist)" = 2 ]
  [ "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' Build/iOS/Info.plist)" = 0.1.0 ]
  git checkout -qb feature
  git commit -q --allow-empty -m Feature
  [ "$(script/build-number)" = 2 ]
  git checkout -q --detach main
  git merge -q --no-ff feature -m 'Test pull request'
  [ "$(GITHUB_REF=refs/pull/1/merge script/build-number)" = 2 ]
  git checkout -q --detach main^
  [ "$(script/build-number)" = 1 ]
)
# The fixtures exercise iOS first, even in the macOS workflow job.
unset TESTFLIGHT_PLATFORM APP_STORE_PROFILE
export TESTFLIGHT_TEST_DIRECTORY="$scratch"
export PATH="$scratch/bin:$PATH"
cat > "$scratch/bin/security" <<'SECURITY'
#!/bin/bash
set -euo pipefail
echo "$1" >> "$TESTFLIGHT_TEST_DIRECTORY/security.log"
case "$1" in
  list-keychains)
    if [[ $# == 3 ]]; then
      cat "${TESTFLIGHT_TEST_DIRECTORY}/keychains"
      [[ "$TESTFLIGHT_TEST_FAILURE" != list ]]
    else
      shift 4
      printf '%s\n' "$@" > "$TESTFLIGHT_TEST_DIRECTORY/keychains"
    fi
    ;;
  create-keychain)
    echo /created-concurrently.keychain-db >>"${TESTFLIGHT_TEST_DIRECTORY}/keychains"
    dirname "$4" > "$TESTFLIGHT_TEST_DIRECTORY/credentials"
    [[ "$TESTFLIGHT_TEST_FAILURE" != create ]]
    ;;
  delete-keychain)
    awk -v removed="$2" '$0 != removed' "${TESTFLIGHT_TEST_DIRECTORY}/keychains" >"${TESTFLIGHT_TEST_DIRECTORY}/remaining"
    mv "${TESTFLIGHT_TEST_DIRECTORY}/remaining" "${TESTFLIGHT_TEST_DIRECTORY}/keychains"
    ;;
  cms)
    echo /concurrent.keychain-db > "$TESTFLIGHT_TEST_DIRECTORY/keychains"
    cat "$4"
    ;;
  import) [[ "$TESTFLIGHT_TEST_FAILURE" != import ]] ;;
  find-identity)
    test "${!#}" = "$(cat "$TESTFLIGHT_TEST_DIRECTORY/credentials")/signing.keychain-db"
    if [[ "$2" == -v ]]; then
      test "$3 $4" = '-p basic'
      echo '  1) AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA "Apple Distribution: Tester (ABCDEFGHIJ)"'
      echo '  2) BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB "3rd Party Mac Developer Installer: Tester (OTHERTEAM1)"'
      echo '  3) CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC "Developer ID Installer: Tester (ABCDEFGHIJ)"'
      if [[ "$TESTFLIGHT_TEST_FAILURE" != missing-installer ]]; then
        echo '  4) DDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDD "3rd Party Mac Developer Installer: Tester (ABCDEFGHIJ)"'
      fi
    fi
    ;;
esac
SECURITY
cat > "$scratch/bin/xcodebuild" <<'XCODEBUILD'
#!/bin/bash
set -euo pipefail
if [[ ${TESTFLIGHT_PLATFORM:-iOS} == macOS ]]; then
  test "$(umask)" = 0022 || { echo 'Mac builds must be readable by other users' >&2; exit 1; }
fi
echo /archive-concurrent.keychain-db >>"${TESTFLIGHT_TEST_DIRECTORY}/keychains"
if [[ "$1" == -exportArchive ]]; then
  [[ "$8" == -authenticationKeyPath ]]
  openssl pkey -in "$9" -noout
  case "$TESTFLIGHT_TEST_FAILURE" in
    dry-run|verify|validation|upload-archive) internal=false ;;
    external) internal=false ;;
    *) internal=true ;;
  esac
  destination="$(/usr/libexec/PlistBuddy -c 'Print :destination' "$5")"
  test "$(/usr/libexec/PlistBuddy -c 'Print :testFlightInternalTestingOnly' "$5")" = "$internal"
  if [[ "${TESTFLIGHT_PLATFORM:-iOS}" == macOS ]]; then
    test "$(/usr/libexec/PlistBuddy -c 'Print :installerSigningCertificate' "$5")" = DDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDD || {
      echo 'Mac export must select the imported team installer by fingerprint' >&2; exit 1
    }
  fi
  if [[ "$destination" == export ]]; then
    mkdir -p "$7"
    if [[ "${TESTFLIGHT_PLATFORM:-iOS}" == macOS ]]; then touch "$7/Game.pkg"; else touch "$7/Game.ipa"; fi
  fi
  echo "$destination" >> "$TESTFLIGHT_TEST_DIRECTORY/calls"
  /usr/libexec/PlistBuddy -c 'Print :provisioningProfiles:com.mikemcquaid.Infinigame' "$5" > "$TESTFLIGHT_TEST_DIRECTORY/exported-profile"
  [[ "$TESTFLIGHT_TEST_FAILURE" != export ]]
else
  plist=Build/iOS/Info.plist
  if [[ "${TESTFLIGHT_PLATFORM:-iOS}" == macOS ]]; then
    plist=Build/MacStore/Infinigame/Info.plist
    test "$(stat -f %Lp Build/MacStore/Infinigame/private-resource)" = 644
    [[ "$2" == Build/MacStore/MacStore.xcodeproj && "$4" == Infinigame ]]
    [[ " $* " == *" -destination generic/platform=macOS "* && " $* " == *" PROVISIONING_PROFILE_SPECIFIER="* ]]
    [[ -f "$HOME/Library/Developer/Xcode/UserData/Provisioning Profiles/$PROFILE_UUID.provisionprofile" ]]
    [[ "$(/usr/libexec/PlistBuddy -c 'Print ITSAppUsesNonExemptEncryption' "$plist")" == false ]]
  fi
  if [[ "$TESTFLIGHT_TEST_FAILURE" != dry-run ]]; then
    [[ "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleVersion' "$plist")" == 44 ]]
    [[ "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$plist")" == 1.2.3 ]]
  fi
  archive="Build/TestFlight/${TESTFLIGHT_PLATFORM:-iOS}.xcarchive"
  mkdir -p "$archive"
  plutil -create xml1 "$archive/Info.plist"
  /usr/libexec/PlistBuddy -c 'Add :ApplicationProperties dict' \
    -c 'Add :ApplicationProperties:ApplicationPath string Applications/Infinigame.app' \
    -c 'Add :ApplicationProperties:CFBundleVersion string 44' \
    -c 'Add :ApplicationProperties:CFBundleShortVersionString string 1.2.3' \
    -c 'Add :ApplicationProperties:CFBundleIdentifier string com.mikemcquaid.Infinigame' "$archive/Info.plist"
  if [[ ${TESTFLIGHT_PLATFORM:-iOS} == iOS ]]; then
    app="$archive/Products/Applications/Infinigame.app"
    mkdir -p "$app"
    plutil -create xml1 "$app/Info.plist"
    plutil -replace DTSDKName -string iphoneos27.1 "$app/Info.plist"
  fi
  echo archive >> "$TESTFLIGHT_TEST_DIRECTORY/calls"
  [[ "$TESTFLIGHT_TEST_FAILURE" != archive ]]
fi
XCODEBUILD
cat > "$scratch/bin/xcrun" <<'XCRUN'
#!/bin/bash
set -euo pipefail
test "$1 $2 $3" = 'altool --validate-app -f'
test -f "$4"
if [[ "${TESTFLIGHT_PLATFORM:-iOS}" == macOS ]]; then
  [[ "$4" == *.pkg && "$5 $6" == '-t macos' ]]
else
  [[ "$4" == *.ipa && "$5 $6" == '-t ios' ]]
fi
test -f "$API_PRIVATE_KEYS_DIR/AuthKey_${APP_STORE_KEY_ID}.p8"
test "$(stat -f %Lp "$API_PRIVATE_KEYS_DIR/AuthKey_${APP_STORE_KEY_ID}.p8")" = 600
echo validate >> "$TESTFLIGHT_TEST_DIRECTORY/calls"
[[ "$TESTFLIGHT_TEST_FAILURE" != validation ]]
XCRUN
chmod +x "$scratch/bin/"*
export APP_STORE_KEY_ID=KEY1234567 APP_STORE_ISSUER_ID=issuer
APP_STORE_KEY=$(openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:prime256v1 -pkeyopt ec_param_enc:named_curve | base64)
export APP_STORE_KEY
export APP_STORE_CERTIFICATES=dGVzdA== APP_STORE_CERTIFICATES_PASSWORD=password
export APP_STORE_IOS_PROFILE RELEASE_VERSION=1.2.3 BUILD_NUMBER=44
uuid="$(uuidgen)"
plutil -create xml1 "$scratch/profile.plist"
/usr/libexec/PlistBuddy -c "Add :UUID string $uuid" \
  -c 'Add :TeamIdentifier array' -c 'Add :TeamIdentifier:0 string ABCDEFGHIJ' \
  -c 'Add :Entitlements dict' \
  -c 'Add :Entitlements:application-identifier string OLDPREFIX1.com.mikemcquaid.Infinigame' "$scratch/profile.plist"
cp "$scratch/profile.plist" "$scratch/invalid.plist"
for failure in profile-case profile-prefix list create import archive export none external dry-run verify validation upload-archive; do
  export TESTFLIGHT_TEST_FAILURE="$failure"
  APP_STORE_IOS_PROFILE="$(base64 -i "$scratch/profile.plist")"
  if [[ "$failure" == profile-* ]]; then
    invalid=OLDPREFIX1.com.mikemcquaid.infinigame
    [[ "$failure" != profile-prefix ]] || invalid=OLDPREFIX1.other.com.mikemcquaid.Infinigame
    /usr/libexec/PlistBuddy -c "Set :Entitlements:application-identifier $invalid" "$scratch/invalid.plist"
    APP_STORE_IOS_PROFILE="$(base64 -i "$scratch/invalid.plist")"
  fi
  rm -f "$scratch/security.log" "$scratch/calls"
  flag=--internal
  [[ "$failure" != external* ]] || flag=--external
  case "$failure" in
    verify|validation) flag=--verify ;;
    dry-run|upload-archive) flag="--$failure" ;;
  esac
  if "$scratch/script/testflight" "$flag" > "$scratch/run.log" 2>&1; then
    [[ "$failure" == none || "$failure" == external || "$failure" == dry-run || "$failure" == verify || "$failure" == upload-archive ]] || { echo "Ignored $failure failure" >&2; exit 1; }
  else
    [[ "$failure" != none && "$failure" != external && "$failure" != dry-run && "$failure" != verify && "$failure" != upload-archive ]] || { cat "$scratch/run.log"; exit 1; }
  fi
  [[ ! -e "$HOME/Library/Developer/Xcode/UserData/Provisioning Profiles/$uuid.mobileprovision" ]]
  [[ -z "$(ls -A "$scratch/tmp")" ]]
  if [[ "$failure" == profile-* ]]; then
    [[ "$(cat "$scratch/security.log")" == cms ]] || {
      echo 'Profile validation changed the signing keychain' >&2; exit 1
    }
    [[ "$(cat "$scratch/keychains")" == /concurrent.keychain-db ]]
  else
    [[ ! -d "$(cat "$scratch/credentials")" ]]
    grep -qx delete-keychain "$scratch/security.log"
    grep -qx /concurrent.keychain-db "$scratch/keychains"
    grep -qx /created-concurrently.keychain-db "$scratch/keychains"
    if [[ -e "$scratch/calls" ]]; then
      grep -qx /archive-concurrent.keychain-db "$scratch/keychains"
    fi
    if grep -q signing.keychain-db "$scratch/keychains"; then
      echo 'Temporary keychain remained in the search list' >&2; exit 1
    fi
  fi
  case "$failure" in
    profile-*|list|create|import) [[ ! -e "$scratch/calls" ]] ;;
    archive) [[ "$(cat "$scratch/calls")" == archive ]] ;;
    dry-run) [[ "$(cat "$scratch/calls")" == $'archive\nexport' ]] ;;
    verify|validation) [[ "$(cat "$scratch/calls")" == $'archive\nexport\nvalidate' ]] ;;
    upload-archive) [[ "$(cat "$scratch/calls")" == upload ]] ;;
    none|external|export) [[ "$(cat "$scratch/calls")" == $'archive\nupload' ]] ;;
  esac
done
ios_app="$scratch/Build/TestFlight/iOS.xcarchive/Products/Applications/Infinigame.app"
plutil -replace DTSDKName -string iphoneos26.5 "$ios_app/Info.plist"
rm "$scratch/calls"
if TESTFLIGHT_TEST_FAILURE=upload-archive "$scratch/script/testflight" --upload-archive > "$scratch/run.log" 2>&1; then
  echo 'Uploaded an existing iOS archive built with SDK 26.5' >&2; exit 1
fi
grep -q 'iphoneos26.5' "$scratch/run.log"
test ! -e "$scratch/calls"
[[ "$(cat "$scratch/exported-profile")" == "$uuid" ]]
mkdir -p "$scratch/Build/MacStore/MacStore.xcodeproj" "$scratch/Build/MacStore/Infinigame"
touch "$scratch/Build/MacStore/MacStore.xcodeproj/project.pbxproj"
cp "$scratch/Build/iOS/Info.plist" "$scratch/Build/MacStore/Infinigame/"
/usr/libexec/PlistBuddy -c 'Delete :Entitlements:application-identifier' \
  -c 'Add :Entitlements:com.apple.application-identifier string OLDPREFIX1.com.mikemcquaid.Infinigame' "$scratch/profile.plist"
touch "$scratch/Build/MacStore/Infinigame/private-resource"
chmod 600 "$scratch/Build/MacStore/Infinigame/private-resource"
for mode in external dry-run verify upload-archive; do
  rm -f "$scratch/calls"
  TESTFLIGHT_TEST_FAILURE="$mode" TESTFLIGHT_PLATFORM=macOS APP_STORE_PROFILE="$(base64 -i "$scratch/profile.plist")" PROFILE_UUID="$uuid" \
    "$scratch/script/testflight" "--$mode" > "$scratch/run.log" 2>&1 || { cat "$scratch/run.log"; exit 1; }
  expected=$'archive\nexport'
  [[ "$mode" != external ]] || expected=$'archive\nupload'
  [[ "$mode" != verify ]] || expected+=$'\nvalidate'
  [[ "$mode" != upload-archive ]] || expected=upload
  test "$(cat "$scratch/calls")" = "$expected"
  test ! -e "$HOME/Library/Developer/Xcode/UserData/Provisioning Profiles/$uuid.provisionprofile"
done
rm "$scratch/calls"
if BUILD_NUMBER=45 TESTFLIGHT_TEST_FAILURE=upload-archive TESTFLIGHT_PLATFORM=macOS APP_STORE_PROFILE="$(base64 -i "$scratch/profile.plist")" \
    "$scratch/script/testflight" --upload-archive > "$scratch/run.log" 2>&1; then
  echo 'Uploaded an archive with the wrong build number' >&2; exit 1
fi
test ! -e "$scratch/calls"
if TESTFLIGHT_TEST_FAILURE=missing-installer TESTFLIGHT_PLATFORM=macOS APP_STORE_PROFILE="$(base64 -i "$scratch/profile.plist")" PROFILE_UUID="$uuid" \
    "$scratch/script/testflight" --dry-run > "$scratch/run.log" 2>&1; then
  echo 'Accepted a bundle without a valid installer identity for this team' >&2; exit 1
fi
grep -q 'Mac Installer Distribution.*ABCDEFGHIJ' "$scratch/run.log"
test ! -e "$scratch/calls"
test ! -e "$HOME/Library/Developer/Xcode/UserData/Provisioning Profiles/$uuid.provisionprofile"
echo 'TestFlight signing cleanup tests passed'

ruby script/test-testflight-automation.rb
