#!/bin/bash
# Check release gating and signing cleanup without contacting Apple.
set -euo pipefail
cd "$(dirname "$0")/.."
ruby -ryaml <<'WORKFLOW'
workflow = YAML.load_file('.github/workflows/release.yml')
events = workflow['on'] || workflow.fetch(true)
abort 'Publish both TestFlight platforms on main pushes' unless
  events.dig('push', 'branches') == ['main'] && !events['push'].key?('tags') &&
  workflow.dig('jobs', 'testflight', 'strategy', 'matrix', 'platform') == %w[iOS macOS]
abort 'Retry pending external reviews without another push' unless events.key?('schedule')
jobs = workflow.fetch('jobs')
build = YAML.load_file('.github/workflows/build.yml')
builder = YAML.load_file('.github/actions/compile-unity/action.yml').dig('runs', 'steps')
              .find { |step| step['uses'].to_s.start_with?('game-ci/unity-builder@') }.fetch('with')
abort 'Use GameCI custom versioning only for releases' unless
  builder['versioning'] == "${{ inputs.version != '' && 'Custom' || 'None' }}" && builder['version'] == '${{ inputs.version }}'
build_jobs = build.fetch('jobs')
uploads = build_jobs.values.flat_map { |job| job.fetch('steps') }.select { |step| step['uses'].to_s.start_with?('actions/upload-artifact@') }
abort 'Only playable desktop builds belong in platform artefacts' unless uploads.map { |step| step.dig('with', 'name') }.sort == ['Infinigame-${{ matrix.name }}', 'Infinigame-SteamDeck'].sort &&
  build_jobs.dig('build', 'strategy', 'matrix', 'include').map { |row| row.fetch('name') }.sort == %w[Windows macOS]
[ *build_jobs.values, jobs.fetch('testflight') ].each do |job|
  checkout = job.fetch('steps').find { |step| step['uses'].to_s.start_with?('actions/checkout@') }
  abort 'Build numbers need the full commit history' unless checkout.dig('with', 'fetch-depth') == 0
end
credentials = %w[UNITY_EMAIL UNITY_PASSWORD].to_h { |key| [key, "${{ secrets.#{key} }}"] }
events = build['on'] || build.fetch(true)
required = events.fetch('workflow_call').fetch('secrets').select { |_, value| value['required'] }.keys
abort 'Hosted builds require Unity Personal credentials' unless required.sort == credentials.keys.sort
ci_workflow = YAML.load_file('.github/workflows/ci.yml')
ci_events = ci_workflow['on'] || ci_workflow.fetch(true)
abort 'Run platform CI for pull requests to main' unless ci_events.dig('pull_request', 'branches') == ['main']
ci = ci_workflow.fetch('jobs')
gate = ci.fetch('required')
abort 'A skipped or failed platform build must block the PR' unless
  gate['if'] == 'always()' && gate['needs'] == %w[platforms apple-access]
%w[success skipped failure cancelled].product(%w[success skipped failure cancelled]).each do |platforms, apple|
  command = gate.fetch('steps').last.fetch('run').gsub('${{ needs.platforms.result }}', platforms).gsub('${{ needs.apple-access.result }}', apple)
  abort 'Merge gate accepted the wrong build results' unless system('bash', '-c', command) == (platforms == 'success' && apple == 'success')
end
access = ci.fetch('apple-access')
abort 'Read Apple credentials only from a trusted same-repository check using base-branch code' unless
  access['if'] == ci.dig('platforms', 'if') && access.fetch('steps').first.dig('with', 'ref') == "${{ github.event.pull_request.base.sha || 'main' }}"
[ci, jobs].each do |caller|
  abort 'Missing platform build credentials' unless caller.dig('platforms', 'secrets') == credentials
end
abort 'Build the desktop players before using the Unity seat for TestFlight' unless
  jobs.dig('testflight', 'needs') == 'platforms' && jobs.dig('platforms', 'if') == "github.event_name == 'push'"
abort 'A desktop build failure must not skip the Apple betas' unless
  jobs.dig('testflight', 'if') == "${{ !cancelled() && github.event_name == 'push' }}"
abort 'Scheduled reviews must not build players' unless jobs.dig('review', 'if') == "github.event_name == 'schedule'"
abort 'PR CI must not duplicate main builds' if ci_events.key?('push')
steps = jobs.dig('testflight', 'steps')
platform_steps = build_jobs.fetch('build').fetch('steps')
abort 'Exercise Apple release tooling and archive the native Mac TestFlight app on pull requests' unless
  platform_steps.any? { |step| step['run'] == 'script/test-testflight' } &&
  platform_steps.any? { |step| step.dig('with', 'method').to_s.include?('CIMacAndTestFlight') } &&
  platform_steps.any? { |step| step['run'].to_s.include?('MacStore.xcodeproj') && step['run'].include?('CODE_SIGNING_ALLOWED=NO archive') }
prepare_ios = platform_steps.find { |step| step['id'] == 'prepare-ios' }
ios = platform_steps.find { |step| step.dig('with', 'compile-ios') == 'true' }
abort 'Compile unsigned iOS on the desktop Mac runner for unversioned builds' unless
  prepare_ios && prepare_ios.fetch('if').include?("matrix.name == 'macOS'") && prepare_ios.fetch('if').include?('!inputs.desktop-only') &&
  ios && ios.fetch('if').include?("steps.prepare-ios.outcome == 'success'") &&
  build_jobs.size == 1 && platform_steps.count { |step| step['uses'] == './.github/actions/prepare-unity' } == 1
abort 'Sign the iOS export in the same job' if steps.any? { |step| step.dig('with', 'name') == 'Infinigame-iOS' }
abort 'Uploads must share a fixed queue' unless workflow.fetch('concurrency') == { 'group' => 'infinigame-release', 'cancel-in-progress' => false, 'queue' => 'max' }
identity = steps.index { |step| step['id'] == 'prepare' }
save = steps.index { |step| step['name'] == 'Save public TestFlight upload intent' }
plan = steps.index { |step| step['id'] == 'plan' }
upload = steps.index { |step| step['id'] == 'upload' }
abort 'Save and reconcile the identity before uploading' unless [identity, save, plan, upload].all? && identity < save && save < plan && plan < upload
abort 'Upload one external-eligible build for both audiences' unless steps[upload]['run'] == 'script/testflight --external' &&
  steps[upload]['if'] == "steps.plan.outputs.needed == 'true'"
abort 'Public intent must outlive reruns' unless steps[save].dig('with', 'retention-days') == 90
puts 'TestFlight workflow checks passed'
WORKFLOW
mkdir -p tmp
scratch="$(mktemp -d "$PWD/tmp/test-testflight.XXXXXX")"
trap 'rm -rf "$scratch"' EXIT
mkdir -p "$scratch/bin" "$scratch/script" "$scratch/.github" "$scratch/Build/iOS/Unity-iPhone.xcodeproj"
cp script/testflight "$scratch/script/testflight"
cp .github/testflight.rb "$scratch/.github/"
cp TESTFLIGHT.md "$scratch/TESTFLIGHT.md"
touch "$scratch/Build/iOS/Unity-iPhone.xcodeproj/project.pbxproj"
plutil -create xml1 "$scratch/Build/iOS/Info.plist"
/usr/libexec/PlistBuddy -c 'Add :CFBundleVersion string 1.1' -c 'Add :CFBundleShortVersionString string 0.1.0' "$scratch/Build/iOS/Info.plist"
(
  cp script/build-number "$scratch/script/"
  cd "$scratch"
  unset GITHUB_REF
  git init -q -b main
  git config user.name Tester
  git config user.email tester@example.com
  git config commit.gpgsign false
  git commit -q --allow-empty -m First
  git commit -q --allow-empty -m Second
  script/build-number Build/iOS/Info.plist
  [ "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleVersion' Build/iOS/Info.plist)" = 2 ]
  [ "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' Build/iOS/Info.plist)" = 0.1.0 ]
  git checkout -qb feature
  git commit -q --allow-empty -m Feature
  [ "$(script/build-number)" = 2 ]
  git checkout -q --detach main
  git merge -q --no-ff feature -m 'Test pull request'
  [ "$(GITHUB_REF=refs/pull/1/merge script/build-number)" = 2 ]
  git checkout -q --detach main^
  [ "$(script/build-number)" = 1 ]
)
export TESTFLIGHT_TEST_DIRECTORY="$scratch"
export PATH="$scratch/bin:$PATH"
cat > "$scratch/bin/security" <<'SECURITY'
#!/bin/bash
set -euo pipefail
echo "$1" >> "$TESTFLIGHT_TEST_DIRECTORY/security.log"
case "$1" in
  list-keychains)
    if [[ $# == 3 ]]; then
      cat "${TESTFLIGHT_TEST_DIRECTORY}/keychains"
      [[ "$TESTFLIGHT_TEST_FAILURE" != list ]]
    else
      shift 4
      printf '%s\n' "$@" > "$TESTFLIGHT_TEST_DIRECTORY/keychains"
    fi
    ;;
  create-keychain)
    echo /created-concurrently.keychain-db >>"${TESTFLIGHT_TEST_DIRECTORY}/keychains"
    dirname "$4" > "$TESTFLIGHT_TEST_DIRECTORY/credentials"
    [[ "$TESTFLIGHT_TEST_FAILURE" != create ]]
    ;;
  delete-keychain)
    awk -v removed="$2" '$0 != removed' "${TESTFLIGHT_TEST_DIRECTORY}/keychains" >"${TESTFLIGHT_TEST_DIRECTORY}/remaining"
    mv "${TESTFLIGHT_TEST_DIRECTORY}/remaining" "${TESTFLIGHT_TEST_DIRECTORY}/keychains"
    ;;
  cms)
    echo /concurrent.keychain-db > "$TESTFLIGHT_TEST_DIRECTORY/keychains"
    cat "$4"
    ;;
  import) [[ "$TESTFLIGHT_TEST_FAILURE" != import ]] ;;
esac
SECURITY
cat > "$scratch/bin/xcodebuild" <<'XCODEBUILD'
#!/bin/bash
set -euo pipefail
echo /archive-concurrent.keychain-db >>"${TESTFLIGHT_TEST_DIRECTORY}/keychains"
if [[ "$1" == -exportArchive ]]; then
  [[ "$8" == -authenticationKeyPath ]]
  openssl pkey -in "$9" -noout
  if [[ "$TESTFLIGHT_TEST_FAILURE" == external* ]]; then
    [[ "$(/usr/libexec/PlistBuddy -c 'Print :testFlightInternalTestingOnly' "$5")" == false ]]
    [[ "$(/usr/libexec/PlistBuddy -c 'Print :destination' "$5")" == upload ]]
  else
    [[ "$(/usr/libexec/PlistBuddy -c 'Print :testFlightInternalTestingOnly' "$5")" == true ]]
    [[ "$(/usr/libexec/PlistBuddy -c 'Print :destination' "$5")" == upload ]]
  fi
  if [[ "${TESTFLIGHT_PLATFORM:-iOS}" == macOS ]]; then
    [[ "$(/usr/libexec/PlistBuddy -c 'Print :installerSigningCertificate' "$5")" == 'Mac Installer Distribution' ]]
  fi
  echo export >> "$TESTFLIGHT_TEST_DIRECTORY/calls"
  /usr/libexec/PlistBuddy -c 'Print :provisioningProfiles:com.mikemcquaid.Infinigame' "$5" > "$TESTFLIGHT_TEST_DIRECTORY/exported-profile"
  [[ "$TESTFLIGHT_TEST_FAILURE" != export ]]
else
  plist=Build/iOS/Info.plist
  if [[ "${TESTFLIGHT_PLATFORM:-iOS}" == macOS ]]; then
    plist=Build/MacStore/Infinigame/Info.plist
    [[ "$2" == Build/MacStore/MacStore.xcodeproj && "$4" == Infinigame ]]
    [[ " $* " == *" -destination generic/platform=macOS "* && " $* " == *" PROVISIONING_PROFILE_SPECIFIER="* ]]
    [[ -f "$HOME/Library/Developer/Xcode/UserData/Provisioning Profiles/$PROFILE_UUID.provisionprofile" ]]
    [[ "$(/usr/libexec/PlistBuddy -c 'Print ITSAppUsesNonExemptEncryption' "$plist")" == false ]]
  fi
  [[ "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleVersion' "$plist")" == 44 ]]
  [[ "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$plist")" == 1.2.3 ]]
  echo archive >> "$TESTFLIGHT_TEST_DIRECTORY/calls"
  [[ "$TESTFLIGHT_TEST_FAILURE" != archive ]]
fi
XCODEBUILD
chmod +x "$scratch/bin/"*
export APP_STORE_KEY_ID=KEY1234567 APP_STORE_ISSUER_ID=issuer
APP_STORE_KEY=$(openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:prime256v1 | base64)
export APP_STORE_KEY
export APP_STORE_CERTIFICATES=dGVzdA== APP_STORE_CERTIFICATES_PASSWORD=password
export APP_STORE_IOS_PROFILE RELEASE_VERSION=1.2.3 BUILD_NUMBER=44
uuid="$(uuidgen)"
plutil -create xml1 "$scratch/profile.plist"
/usr/libexec/PlistBuddy -c "Add :UUID string $uuid" \
  -c 'Add :TeamIdentifier array' -c 'Add :TeamIdentifier:0 string ABCDEFGHIJ' \
  -c 'Add :Entitlements dict' \
  -c 'Add :Entitlements:application-identifier string OLDPREFIX1.com.mikemcquaid.Infinigame' "$scratch/profile.plist"
cp "$scratch/profile.plist" "$scratch/invalid.plist"
for failure in profile-case profile-prefix list create import archive export none external; do
  export TESTFLIGHT_TEST_FAILURE="$failure"
  APP_STORE_IOS_PROFILE="$(base64 -i "$scratch/profile.plist")"
  if [[ "$failure" == profile-* ]]; then
    invalid=OLDPREFIX1.com.mikemcquaid.infinigame
    [[ "$failure" != profile-prefix ]] || invalid=OLDPREFIX1.other.com.mikemcquaid.Infinigame
    /usr/libexec/PlistBuddy -c "Set :Entitlements:application-identifier $invalid" "$scratch/invalid.plist"
    APP_STORE_IOS_PROFILE="$(base64 -i "$scratch/invalid.plist")"
  fi
  rm -f "$scratch/security.log" "$scratch/calls"
  flag=--internal
  [[ "$failure" != external* ]] || flag=--external
  if "$scratch/script/testflight" "$flag" > "$scratch/run.log" 2>&1; then
    [[ "$failure" == none || "$failure" == external ]] || { echo "Ignored $failure failure" >&2; exit 1; }
  else
    [[ "$failure" != none && "$failure" != external ]] || { cat "$scratch/run.log"; exit 1; }
  fi
  [[ ! -e "$HOME/Library/Developer/Xcode/UserData/Provisioning Profiles/$uuid.mobileprovision" ]]
  [[ -z "$(ls -A "$scratch/tmp")" ]]
  if [[ "$failure" == profile-* ]]; then
    [[ "$(cat "$scratch/security.log")" == cms ]] || {
      echo 'Profile validation changed the signing keychain' >&2; exit 1
    }
    [[ "$(cat "$scratch/keychains")" == /concurrent.keychain-db ]]
  else
    [[ ! -d "$(cat "$scratch/credentials")" ]]
    grep -qx delete-keychain "$scratch/security.log"
    grep -qx /concurrent.keychain-db "$scratch/keychains"
    grep -qx /created-concurrently.keychain-db "$scratch/keychains"
    if [[ -e "$scratch/calls" ]]; then
      grep -qx /archive-concurrent.keychain-db "$scratch/keychains"
    fi
    if grep -q signing.keychain-db "$scratch/keychains"; then
      echo 'Temporary keychain remained in the search list' >&2; exit 1
    fi
  fi
  case "$failure" in
    profile-*|list|create|import) [[ ! -e "$scratch/calls" ]] ;;
    archive) [[ "$(cat "$scratch/calls")" == archive ]] ;;
    external*) [[ "$(cat "$scratch/calls")" == $'archive\nexport' ]] ;;
    export|none) [[ "$(cat "$scratch/calls")" == $'archive\nexport' ]] ;;
  esac
done
[[ "$(cat "$scratch/exported-profile")" == "$uuid" ]]
mkdir -p "$scratch/Build/MacStore/MacStore.xcodeproj" "$scratch/Build/MacStore/Infinigame"
touch "$scratch/Build/MacStore/MacStore.xcodeproj/project.pbxproj"
cp "$scratch/Build/iOS/Info.plist" "$scratch/Build/MacStore/Infinigame/"
/usr/libexec/PlistBuddy -c 'Delete :Entitlements:application-identifier' \
  -c 'Add :Entitlements:com.apple.application-identifier string OLDPREFIX1.com.mikemcquaid.Infinigame' "$scratch/profile.plist"
rm "$scratch/calls"
TESTFLIGHT_PLATFORM=macOS APP_STORE_PROFILE="$(base64 -i "$scratch/profile.plist")" PROFILE_UUID="$uuid" \
  "$scratch/script/testflight" --external > "$scratch/run.log" 2>&1 || { cat "$scratch/run.log"; exit 1; }
[[ "$(cat "$scratch/calls")" == $'archive\nexport' ]]
[[ ! -e "$HOME/Library/Developer/Xcode/UserData/Provisioning Profiles/$uuid.provisionprofile" ]]
echo 'TestFlight signing cleanup tests passed'

ruby script/test-testflight-automation.rb
